    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:ui": "node scripts/verify-ui.mjs",
    "format": "prettier --write src scripts *.json *.ts *.js README.md docs .github"
  },
  "dependencies": {
    "@lucide/svelte": "1.58.0",
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "24.10.0",
    "playwright": "1.62.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
