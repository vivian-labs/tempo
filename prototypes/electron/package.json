{
  "name": "tempo-instrument",
  "productName": "TEMPO",
  "version": "0.1.0",
  "description": "A tactile clock, split-flap display and countdown instrument.",
  "private": true,
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "package": "node scripts/package.mjs",
    "package:win": "node scripts/package.mjs win32 x64",
    "package:mac": "node scripts/package.mjs darwin arm64 && node scripts/package.mjs darwin x64",
    "test:desktop": "node tests/desktop.cjs"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "fflate": "0.8.2",
    "playwright": "^1.62.1",
    "rcedit": "^5.0.2"
  }
}
